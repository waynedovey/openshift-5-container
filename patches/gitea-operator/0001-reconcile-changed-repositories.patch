+# A prior migration may have succeeded when a tenant had only the starter
+# repository. Compute the fingerprint of the CURRENT desired repo list so
+# any subsequent list change causes a new, idempotent migration.
+- name: Calculate desired repository migration fingerprint
+  ansible.builtin.set_fact:
+    _gitea_repositories_migration_hash: "{{ _gitea_repositories_list | default([]) | to_json | hash('sha256') }}"
+
+- name: Migrate repositories only if users and admin user have been created
+  when:
+  - _gitea_create_users | bool
+  - _gitea_admin_user | default("") | length > 0
+  - _gitea_user_number | default(0) | int > 0
+  - _gitea_migrate_repositories | bool
+  - r_gitea_repos.resources | default([]) | length > 0
+  - r_gitea_repos.resources[0].status.userSetupComplete | default(false) | bool
+  - r_gitea_repos.resources[0].status.adminPassword | default("") | length > 0
+  - >-
+    (not (r_gitea_repos.resources[0].status.repoMigrationComplete | default(false) | bool))
+    or ((r_gitea_repos.resources[0].status.repoMigrationConfigHash | default(''))
+        != _gitea_repositories_migration_hash)
+  block:
+  # Mark the old success result stale before verifying a changed repo list.
+  # If import fails, the completion flag remains false and the last
+  # successful fingerprint is preserved for a subsequent retry.
+  - name: Mark repository migration in progress
+    operator_sdk.util.k8s_status:
+      api_version: pfe.rhpds.com/v1
+      kind: Gitea
+      name: "{{ _gitea_name }}"
+      namespace: "{{ _gitea_namespace }}"
+      status:
+        repoMigrationComplete: false
+
+  - name: Set actual admin password
+    ansible.builtin.set_fact:
+      _gitea_actual_admin_password: "{{ r_gitea_repos.resources[0].status.adminPassword }}"
+
+  - name: Migrate repositories
+    ansible.builtin.include_tasks: migrate_repos.yml
+    loop: >-
+      {{
+      ( range(1, _gitea_user_number | int + 1) | list )
+      | product(_gitea_repositories_list | default([]))
+      | list
+      }}
+
+  - name: Save repo migration status in custom resource status
+    operator_sdk.util.k8s_status:
+      api_version: pfe.rhpds.com/v1
+      kind: Gitea
+      name: "{{ _gitea_name }}"
+      namespace: "{{ _gitea_namespace }}"
+      status:
+        repoMigrationComplete: true
+        repoMigrationConfigHash: "{{ _gitea_repositories_migration_hash }}"
